#!/bin/bash
set -euo pipefail

# Uso: dev-docker [--nome NOME] [caminho-do-repo]
#      dev-docker --atalho NOME [caminho-do-repo]   cria o comando dev-docker-NOME
#      dev-docker --atalhos                         lista os atalhos e as pastas deles
#
#   --nome NOME   monta o projeto em /NOME em vez do caminho do host: caminho curto e
#                 memória do Claude com nome estável (~/.claude/projects/-NOME/)
#   --atalho NOME grava ~/.local/bin/dev-docker-NOME, que abre este projeto com
#                 --nome NOME a partir de qualquer pasta. Sem caminho, usa a pasta
#                 onde o terminal está; mostra a pasta e pede confirmação
#
# Variáveis opcionais (detalhes em docs/guias/portas-e-sessoes-paralelas.md):
#   DEV_PORTS="5173 3000 8090:8080"  portas publicadas só em 127.0.0.1
#                                     (padrão: nenhuma — várias sessões em paralelo)
#   DEV_GIT_RW=1                      libera escrita em .git/hooks e .git/config
#   DEV_IMAGE=dev-sandbox:latest      outra tag da imagem

NOME=""
ATALHO=""
LISTAR=0
ARG_PATH=""
while [ $# -gt 0 ]; do
  case "$1" in
    --nome|--atalho)
      [ $# -ge 2 ] || { echo "$1 precisa de um nome (ex.: $1 ferrum)." >&2; exit 1; }
      if [ "$1" = "--nome" ]; then NOME="$2"; else ATALHO="$2"; fi
      shift 2 ;;
    --atalhos) LISTAR=1; shift ;;
    -*)       echo "Opção desconhecida: $1" >&2; exit 1 ;;
    *)        ARG_PATH="$1"; shift ;;
  esac
done
REPO_PATH="$(realpath "${ARG_PATH:-.}")"

# Nome de projeto: vira /NOME dentro do container. Letras minúsculas, números,
# ponto, hífen e sublinhado; nunca o nome de uma pasta do sistema.
valida_nome() {
  case "$1" in
    ""|*[!a-z0-9._-]*|[._-]*) echo "Nome inválido: '$1' (use a-z, 0-9, . _ -)." >&2; exit 1 ;;
    bin|boot|dev|etc|home|lib|lib32|lib64|libx32|media|mnt|opt|proc|root|run|sbin|srv|sys|tmp|usr|var)
      echo "'$1' é uma pasta do sistema; escolha outro nome." >&2; exit 1 ;;
  esac
}

# ── Atalhos: dev-docker-NOME ─────────────────────────────────────
# O atalho guarda a pasta para sempre: confirmar qual é evita vincular a
# pasta errada (a home inteira, uma subpasta, outro projeto).
pasta_do_atalho() { sed -n 's/^# pasta: //p' "$1"; }

if [ "$LISTAR" = "1" ]; then
  achou=0
  for f in "$HOME"/.local/bin/dev-docker-*; do
    [ -f "$f" ] && grep -q "gerado por dev-docker --atalho" "$f" || continue
    printf '  %-28s → %s\n' "$(basename "$f")" "$(pasta_do_atalho "$f")"; achou=1
  done
  [ "$achou" = "1" ] || echo "Nenhum atalho criado ainda (dev-docker --atalho NOME)."
  exit 0
fi

if [ -n "$ATALHO" ]; then
  valida_nome "$ATALHO"
  if [ "$REPO_PATH" = "/" ] || [ "$REPO_PATH" = "$HOME" ] || [[ "$HOME" == "$REPO_PATH"/* ]]; then
    echo "Recusado: '$REPO_PATH' não é a pasta de um projeto (é a raiz ou contém a sua home)." >&2
    echo "Abra o terminal dentro da pasta do projeto, ou passe o caminho dela." >&2
    exit 1
  fi
  DEST="$HOME/.local/bin/dev-docker-$ATALHO"
  if [ -e "$DEST" ] && ! grep -q "gerado por dev-docker --atalho" "$DEST"; then
    echo "$DEST já existe e não foi criado pelo dev-docker; nada foi alterado." >&2; exit 1
  fi
  echo "O comando dev-docker-$ATALHO vai abrir sempre esta pasta:"
  echo "    $REPO_PATH"
  if [ ! -d "$REPO_PATH/.git" ] && git -C "$REPO_PATH" rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "    (atenção: esta pasta fica dentro do repositório $(git -C "$REPO_PATH" rev-parse --show-toplevel);"
    echo "     se a ideia era o projeto inteiro, use essa pasta)"
  fi
  if [ -e "$DEST" ]; then
    echo "Ele já existe e hoje abre: $(pasta_do_atalho "$DEST")"
    echo "Confirmar troca o destino."
  fi
  read -r -p "Confirma? Digite 's' para criar: " resposta || resposta=""
  [ "$resposta" = "s" ] || [ "$resposta" = "S" ] || { echo "Cancelado. Nada foi alterado."; exit 1; }
  mkdir -p "$HOME/.local/bin"
  printf '#!/bin/bash\n# gerado por dev-docker --atalho %s\n# pasta: %s\nexec %q --nome %q %q "$@"\n' \
    "$ATALHO" "$REPO_PATH" "$(realpath "$0")" "$ATALHO" "$REPO_PATH" > "$DEST"
  chmod +x "$DEST"
  echo "Pronto. De qualquer terminal, em qualquer pasta, digite:  dev-docker-$ATALHO"
  echo "Dentro do container o projeto fica em /$ATALHO. Ver todos: dev-docker --atalhos"
  exit 0
fi
[ -n "$NOME" ] && valida_nome "$NOME"
HOST_UID="$(id -u)"
HOST_GID="$(id -g)"
IMAGE="${DEV_IMAGE:-dev-sandbox:latest}"

# Pasta genérica: qualquer coisa que uma ferramenta gravar em $HOME dentro
# do container, sem overlay específico abaixo, persiste aqui automaticamente.
DEV_HOME_PATH="$HOME/.cache/dev-sandbox/home"

# Credenciais/config REAIS do seu usuário — as mesmas pastas que uma
# instalação nativa (fora do Docker) de cada agente já usa.
GEMINI_PATH="$HOME/.gemini"   # agy
CLAUDE_PATH="$HOME/.claude"   # Claude Code
CODEX_PATH="$HOME/.codex"     # Codex CLI

# Cache de pacotes cargo — separado por design (ver DOCUMENTACAO.md).
CARGO_CACHE_PATH="$HOME/.cache/dev-sandbox/cargo"

mkdir -p "$DEV_HOME_PATH/.cache/claude-tmp" "$GEMINI_PATH" "$CLAUDE_PATH" \
  "$CODEX_PATH" "$CARGO_CACHE_PATH"

# ── Onde o repositório aparece dentro do container ───────────────
# No mesmo caminho do host: o Claude Code separa memória e histórico por
# caminho (~/.claude/projects/<caminho>), então cada projeto fica com os
# seus — em /workspace fixo, todos os projetos se misturavam.
# Pastas de sistema (raras como repositório) caem em /workspace.
case "$REPO_PATH" in
  /|/bin*|/boot*|/dev*|/etc*|/lib*|/opt*|/proc*|/root*|/run*|/sbin*|/sys*|/tmp*|/usr*|/var*)
    MOUNT_PATH="/workspace" ;;
  *)
    MOUNT_PATH="$REPO_PATH" ;;
esac
[ -n "$NOME" ] && MOUNT_PATH="/$NOME"

# Montar / ou a sua home inteira entrega ao agente tudo o que o sandbox
# deveria esconder (chaves SSH, navegador, outros projetos).
if [ "$REPO_PATH" = "/" ] || [ "$REPO_PATH" = "$HOME" ] || [[ "$HOME" == "$REPO_PATH"/* ]]; then
  echo "⚠️  Você vai montar '$REPO_PATH' inteiro, com escrita, em /${NOME:-workspace}."
  echo "   O agente terá acesso a tudo aí dentro, inclusive a sua home."
  read -r -p "   Digite 'sim' para continuar: " resposta
  [ "$resposta" = "sim" ] || { echo "Cancelado."; exit 1; }
  MOUNT_PATH="/${NOME:-workspace}"
fi

# ── Proteção do .git ─────────────────────────────────────────────
# Hooks e config do git rodam no HOST quando você faz commit/push fora do
# container. Somente leitura aqui dentro, o agente ainda faz commit, mas
# não planta um hook nem um core.fsmonitor/alias que execute código no seu
# usuário real. Ver docs/guias/seguranca.md.
# Vale também para repositórios dentro da pasta montada, até dois níveis
# abaixo (uma pasta com vários clones lado a lado). Não cobre: repositórios
# mais fundos, submódulos (os hooks deles ficam em .git/modules/) e um .git
# criado durante a sessão.
GIT_MOUNTS=()
GIT_PROTECTED=0
if [ "${DEV_GIT_RW:-0}" != "1" ]; then
  while IFS= read -r -d '' gitdir; do
    rel="${gitdir#"${REPO_PATH%/}"}"
    mkdir -p "$gitdir/hooks"
    GIT_MOUNTS+=(--mount "type=bind,src=$gitdir/hooks,dst=$MOUNT_PATH$rel/hooks,readonly")
    if [ -f "$gitdir/config" ]; then
      GIT_MOUNTS+=(--mount "type=bind,src=$gitdir/config,dst=$MOUNT_PATH$rel/config,readonly")
    fi
    GIT_PROTECTED=$((GIT_PROTECTED + 1))
  done < <(find "$REPO_PATH" -maxdepth 3 \( -name node_modules -o -name target \) -prune \
             -o -name .git -type d -print0 -prune 2>/dev/null)
fi

# ── Portas (opcional) ────────────────────────────────────────────
# Sem portas fixas, dá para abrir quantos containers quiser ao mesmo tempo.
PORT_ARGS=()
for p in ${DEV_PORTS:-}; do
  case "$p" in
    *:*) PORT_ARGS+=(-p "127.0.0.1:$p") ;;
    *)   PORT_ARGS+=(-p "127.0.0.1:$p:$p") ;;
  esac
done

# Nome único por sessão: identifica o container e permite várias em paralelo.
SLUG="$(basename "${NOME:-$REPO_PATH}" | tr -c 'a-zA-Z0-9_.-' '-' | sed 's/^[-.]*//; s/-*$//' | cut -c1-40)"
NAME="dev-${SLUG:-raiz}-$$"

echo "▶ $NAME  |  $REPO_PATH → $MOUNT_PATH  |  portas: ${DEV_PORTS:-nenhuma}  |  .git protegidos: $GIT_PROTECTED"
echo "  Outro terminal neste container: sudo docker exec -it $NAME bash"

sudo docker run -it --rm \
  --name "$NAME" \
  --hostname dev-sandbox \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  "${PORT_ARGS[@]}" \
  --user "$HOST_UID:$HOST_GID" \
  --env "HOME=/tmp/dev-home" \
  --env "DEV_SANDBOX=1" \
  --env "DEV_SANDBOX_NAME=$NAME" \
  --env "DEV_SANDBOX_PORTS=${DEV_PORTS:-}" \
  --env "CLAUDE_CODE_TMPDIR=/tmp/dev-home/.cache/claude-tmp" \
  --mount "type=bind,src=$REPO_PATH,dst=$MOUNT_PATH" \
  "${GIT_MOUNTS[@]}" \
  --mount "type=bind,src=$DEV_HOME_PATH,dst=/tmp/dev-home" \
  --mount "type=bind,src=$GEMINI_PATH,dst=/tmp/dev-home/.gemini" \
  --mount "type=bind,src=$CLAUDE_PATH,dst=/tmp/dev-home/.claude" \
  --mount "type=bind,src=$CODEX_PATH,dst=/tmp/dev-home/.codex" \
  --mount "type=bind,src=$CARGO_CACHE_PATH,dst=/usr/local/cargo/registry" \
  --workdir "$MOUNT_PATH" \
  "$IMAGE"
