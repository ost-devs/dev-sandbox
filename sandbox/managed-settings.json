{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Edit(~/.codex/auth.json)",
      "Read(~/.gemini/**/*cred*)",
      "Edit(~/.gemini/**/*cred*)",
      "Read(~/.gemini/**/*token*)",
      "Edit(~/.gemini/**/*token*)"
    ]
  }
}
